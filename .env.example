# Database
DATABASE_URL=postgresql+asyncpg://farma:farmapass@postgres:5432/farmacompare
DATABASE_URL_SYNC=postgresql://farma:farmapass@postgres:5432/farmacompare

# Application
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Collector
COLLECTOR_TIMEOUT_SECONDS=15
COLLECTOR_CONCURRENCY=3
COLLECTOR_INTERVAL_MINUTES=60
COLLECTOR_RETRY_ATTEMPTS=3
COLLECTOR_RETRY_DELAY_SECONDS=5

# Postgres (used by docker-compose)
POSTGRES_DB=farmacompare
POSTGRES_USER=farma
POSTGRES_PASSWORD=farmapass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
